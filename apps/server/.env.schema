# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# S3-compatible bucket for guest avatars (Railway bucket in production)
# @public @type=url
S3_ENDPOINT=
# @public @type=string(minLength=1)
S3_BUCKET=
# @type=string(minLength=1)
S3_ACCESS_KEY_ID=
# @type=string(minLength=1)
S3_SECRET_ACCESS_KEY=
# @public @type=string
S3_REGION=us-east-1
# Railway buckets need virtual-hosted-style URLs
# @public @type=boolean
S3_VIRTUAL_HOSTED_STYLE=false

# OAuth providers; a provider is disabled unless both values are set
# @required=false @public
GOOGLE_CLIENT_ID=
# @required=false
GOOGLE_CLIENT_SECRET=
# @required=false @public
GITHUB_CLIENT_ID=
# @required=false
GITHUB_CLIENT_SECRET=
