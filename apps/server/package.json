{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "dotenvx run -fk ../../.env.keys -- bun run --hot src/index.ts",
    "start": "env=\"$(dotenvx get -f .env.production -fk ../../.env.keys --format eval-export)\" && eval \"$env\" && exec bun dist/index.mjs",
    "auth:generate": "dotenvx run -fk ../../.env.keys -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@dotenvx/dotenvx": "^2.34.2",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@thicctactoe/api": "workspace:*",
    "@thicctactoe/auth": "workspace:*",
    "@thicctactoe/db": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "^4.13.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@thicctactoe/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
