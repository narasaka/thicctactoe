{
  "name": "thicctactoe",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.2",
      "@orpc/server": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "1.7.7",
      "lucide-react": "^1.41.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@orpc/client": "^1.15.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @thicctactoe/db --",
    "db:studio": "turbo run db:studio -F @thicctactoe/db --",
    "db:generate": "turbo run db:generate -F @thicctactoe/db --",
    "db:migrate": "turbo run db:migrate -F @thicctactoe/db --",
    "auth:generate": "cd apps/server && bun run auth:generate",
    "check": "oxlint && oxfmt --write",
    "db:migrate:production": "turbo run db:migrate:production -F @thicctactoe/db --",
    "env:encrypt": "bun scripts/env-encrypt.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.34.2",
    "@thicctactoe/config": "workspace:*",
    "@types/bun": "catalog:",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.3"
}
