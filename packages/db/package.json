{
  "name": "@thicctactoe/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b",
    "db:push": "dotenvx run -f ../../apps/server/.env -fk ../../.env.keys -- drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "dotenvx run -f ../../apps/server/.env -fk ../../.env.keys -- drizzle-kit studio",
    "db:migrate": "dotenvx run -f ../../apps/server/.env -fk ../../.env.keys -- drizzle-kit migrate",
    "db:migrate:production": "dotenvx run -f ../../apps/server/.env.production -fk ../../.env.keys -- drizzle-kit migrate"
  },
  "dependencies": {
    "@thicctactoe/game": "workspace:*",
    "drizzle-orm": "catalog:",
    "nanoid": "^6.0.2",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.34.2",
    "@thicctactoe/config": "workspace:*",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "catalog:"
  }
}
